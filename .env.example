POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=staffflow
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@postgres:5432/staffflow

REDIS_URL=redis://redis:6379/0

# HS256 (oddiy) – vaqtincha ishlatishingiz mumkin, keyin RSA ga o‘tkazasiz
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

GEOFENCE_LAT=41.311081
GEOFENCE_LON=69.240562
GEOFENCE_RADIUS_METERS=500
# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=admin123
