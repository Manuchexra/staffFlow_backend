POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=staffflow
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@postgres:5432/staffflow

REDIS_URL=redis://redis:6379/0

# HS256 (oddiy) – vaqtincha ishlatishingiz mumkin, keyin RSA ga o‘tkazasiz
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Geofence sozlamalari (Sergeli, Toshkent)
GEOFENCE_LAT=41.203657
GEOFENCE_LON=69.237730
GEOFENCE_RADIUS_METERS=200
# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=admin123
# Email SMTP (OTP yuborish uchun)
# Test rejimida: SMTP_MOCK=true
# Production'da: SMTP_MOCK=false va SMTP_SERVER, SMTP_PORT, SMTP_EMAIL, SMTP_PASSWORD o'rnatish
SMTP_MOCK=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=mnurmexrojova@gmail.com
SMTP_PASSWORD=pvovhubqqiizaigs
SMTP_FROM_NAME=StaffFlow